{
  "name": "charged-particle-tracker",
  "productName": "Charged Particle Tracker",
  "version": "0.1.0",
  "description": "SRIM-like multilayer charged-particle Monte Carlo with ENDF-6 reaction data, activation and γ spectra",
  "author": "Daniel Cano Ott <DCanoOtt@users.noreply.github.com>",
  "homepage": "https://github.com/DCanoOtt/charged-particle-tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/DCanoOtt/charged-particle-tracker.git"
  },
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "es.ciemat.chargedparticletracker",
    "productName": "Charged Particle Tracker",
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "maintainer": "Daniel Cano Ott <DCanoOtt@users.noreply.github.com>",
      "synopsis": "Charged-particle transport and activation simulator"
    }
  }
}
